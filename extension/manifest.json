{
  "manifest_version": 3,
  "name": "Redmine — тёмная тема",
  "version": "1.0.2",
  "description": "Переключает тёмную тему на project.simplex48.ru.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Redmine — тёмная тема",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://project.simplex48.ru/*"],
      "css": ["theme.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
